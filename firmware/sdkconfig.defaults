# Disabling the walter-modem protocols this pager never uses
# (CONFIG_WALTER_MODEM_ENABLE_SOCKETS/_HTTP/_COAP/_BLUECHERRY) to
# reclaim RTC memory and flash. All four symbols exist, but every one of
# them (individually and together) FAILS TO BUILD against v1.5.0 as checked
# out here: WalterModem.cpp's _dispatchEvent() unconditionally references
# handler->httpHandler/coapHandler/socketHandler and WalterModemEvent's
# ev->http/coap/socket members without a matching #if guard, and the MOTA
# firmware-upgrade code unconditionally references _blueCherry.ota_buffer
# even though _blueCherry itself is declared inside
# `#if CONFIG_WALTER_MODEM_ENABLE_BLUECHERRY`. Disabling any of these four
# options breaks the vendor library's own compilation, not just ours.
#
# The managed component is never patched in place (firmware/README.md), so
# none of these are disabled here. The RTC memory pressure this was meant to
# relieve is instead addressed by sizing modes.c's own RTC struct to fit the
# ~7kB the library already consumes in this configuration (see
# modes_boot()'s sizeof() log).

# F3.1 (docs/DEVICE_TASKS.md): custom partition table — nvs/assets/otadata
# plus two OTA app slots, docs/DEVICE_PLAN.md §3.4. Flash size follows the
# real Walter module (16 MB, DEVICE_PLAN.md §5.1), not the ESP-IDF generic
# 2 MB default, which is too small for this layout.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# F3.5 (docs/DEVICE_TASKS.md): setup.c's setup_derive() needs mbedtls_hkdf()
# for the setup code's bid/bpw/bkey derivation (docs/DEVICE_PLAN.md §3.2);
# off by default in ESP-IDF 5.2's mbedtls Kconfig.
CONFIG_MBEDTLS_HKDF_C=y

# This board exposes exactly one USB connector, wired to the ESP32-S3's
# native USB-Serial/JTAG peripheral -- UART0's own RX/TX pins (the
# ESP-IDF default console) go nowhere reachable from that connector. Found
# on real hardware: main.c's Setup-mode console (`setup <code>`) was bound
# to UART0 and silently could not be typed into over the flashing/monitor
# cable, even though boot/log output appeared fine (log output already
# went out over USB-Serial/JTAG as the *secondary* console). Promoting it
# to the *primary* console unifies input and output on the one connection
# that actually exists, and is required for esp_console_new_repl_usb_
# serial_jtag() (main.c) to even compile -- that API is gated behind this
# exact Kconfig symbol, not the secondary-console one.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# modes_run() runs on the main task and drives ui/gfx, mbedtls HMAC and the
# modem library; the 3584-byte default overflowed on hardware. Same size the
# setup REPL task already needed (main.c).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# v0.2: TLS profile 3 is used for the CA fetch (docs/V02_DESIGN.md 4.4). The vendored modem
# library's Kconfig default is now 6, but an existing sdkconfig keeps whatever it had (3), and
# then tlsConfigProfile(3) fails locally with NO_SUCH_PROFILE. Found on hardware 2026-09-20.
# Pin it here so every build tree gets it.
CONFIG_WALTER_MODEM_MAX_TLS_PROFILES=6
