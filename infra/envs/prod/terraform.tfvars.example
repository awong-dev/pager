# Copy to terraform.tfvars and fill in real values. NEVER commit
# terraform.tfvars (it is .gitignore'd -- see infra/README.md). This file
# itself must never contain a real secret value; nothing here is
# security-sensitive by design (Secret Manager *values* are added
# out-of-band with `gcloud secrets versions add`, never through Terraform).

project_id  = "my-pager-project"
region      = "us-central1"
github_org  = "my-github-org"
github_repo = "pager"

# relay_image: deliberately NOT set here. CI owns the relay image
# (`-var relay_image=<repo>:<sha>` in .github/workflows/deploy.yml); when unset,
# a local apply keeps whatever Cloud Run currently serves. Only the very first
# apply passes it on the command line (infra/README.md step 8). Setting it in
# terraform.tfvars to a moving tag like :latest rolled prod back (7 Oct 2026).

# EMQX Cloud Serverless's REST API base URL, from its console after signup
# (docs/SERVER_PLAN.md §9.4; infra/README.md's runbook step covers this).
broker_api_url = "https://<your-deployment>.emqxsl.com:8443/api/v5"

# The broker's MQTT(S) hostname, baked into every setup code (required).
broker_host = "<your-deployment>.emqxsl.com"

# Root CA devices pin for the broker (docs/DEVICE_PLAN.md section 3.3).
# Leave unset to pin nothing (validation off). For EMQX Cloud Serverless:
# broker_ca_pem_file = "certs/digicert-global-root-g2.pem"

# This deployment's own public HTTPS origin (docs/V02_DESIGN.md §4.4) --
# needed once a CA is pinned above, so the bootstrap bundle's CA pointer
# (`GET /ca/{sha256hex}.pem`) resolves to something real. Cloud Run's own
# URL is only known after the first apply (a cyclic reference otherwise),
# so this is set by hand, e.g.:
# public_base_url = "https://pager-relay-xxxxxxxxxx-uw.a.run.app"

# Optional overrides (defaults shown):
# firestore_location     = "nam5"
# custom_domain          = ""
# enable_phone_auth      = true
# enable_email_link_auth = true
# cell_geo_provider      = "none"  # "google" | "opencellid" | "none" (docs/PROTOCOL.md §13.2)
# enable_cell_geo_secret = false   # flip once CELL_GEO_API_KEY has a real value set
# time_zone              = "America/Los_Angeles"
# use_broker_gce         = false   # EMQX Cloud Serverless is the default plan (D2)
# broker_domain          = ""      # required if use_broker_gce = true
# letsencrypt_email      = ""      # required if use_broker_gce = true

# Firmware OTA bucket (docs/OTA_DESIGN.md). fw_publishers lists who may upload
# with tools/fwpub.py; fw_bucket_name defaults to "<project_id>-pager-fw".
# fw_bucket_name = ""
fw_publishers = ["user:you@example.com"]

# PUSH_BACKEND is not a tfvars knob here -- this env's main.tf passes
# push_backend = "fcm" to the relay-service module unconditionally (docs/
# V03_PLAN.md §3a, task 3a.3). See infra/README.md step 9 for the
# NEXT_PUBLIC_FIREBASE_VAPID_KEY repo secret this depends on client-side.
