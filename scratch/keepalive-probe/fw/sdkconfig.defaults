# Subset of firmware/sdkconfig.defaults that the modem / sleep path depends on.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_WALTER_MODEM_MAX_TLS_PROFILES=6
# Same sleep GPIO handling as the pager (net_sleep() relies on it for RTS).
CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND=y
# Compile the library's AT trace ESP_LOGD in (runtime level stays INFO unless PROBE_AT_TRACE).
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
# Pager runs 16 MB flash + quad PSRAM; not needed here, but the module has it.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60
# Set to your public IP or DDNS name before building (keep it out of git; the repo is public).
CONFIG_PROBE_BROKER_HOST="CHANGE_ME"
CONFIG_PROBE_APN="soracom.io"
CONFIG_PROBE_APN_USER="sora"
CONFIG_PROBE_APN_PASS="sora"
CONFIG_PROBE_TLS_PROFILE=2
CONFIG_PROBE_CA_SLOT=12
CONFIG_PROBE_AT_TRACE=y
