# RELAY_TOKEN gates the legacy `RELAY_TOKEN`-bearer endpoints only
# (POST/GET /api/devices/{id}/messages, deleted in Phase 6, docs/SERVER_PLAN.md
# §5.1) -- everything else uses a Firebase ID token (app/auth.py).
RELAY_TOKEN=your_secure_token_here

# The relay never holds an MQTT connection (docs/SERVER_PLAN.md §2 decision
# 1). Device traffic arrives via POST /webhooks/mqtt from the broker's rule
# engine (auth: WEBHOOK_KEY below); the relay publishes /down through the
# broker's REST publish API at BROKER_API_URL.
BROKER_API_URL=http://emqx:18083/api/v5
BROKER_API_KEY=dev-broker-api-key
BROKER_API_SECRET=dev-broker-api-secret
WEBHOOK_KEY=dev-webhook-key

# Unused now that Firestore replaced SQLite (docs/SERVER_PLAN.md §2 decision
# 3) -- kept only so an old .env doesn't need editing; safe to delete.
RELAY_DB_PATH=relay.db

# Firestore is the only store; firebase-admin is emulator-aware via these
# two env vars (app/db/firestore.py). Point them at the `firebase` compose
# service (docker-compose.yml) or a locally-run
# `firebase emulators:start --only firestore,auth --project demo-pager`.
FIRESTORE_EMULATOR_HOST=firebase:8080
FIREBASE_AUTH_EMULATOR_HOST=firebase:9099
GOOGLE_CLOUD_PROJECT=demo-pager

# DEV_MODE=1 enables POST /api/dev/token (docs/SERVER_PLAN.md §5.1, §8) --
# never set this in a real deployment.
DEV_MODE=1

# docs/PROTOCOL.md §13.4: how long a loc_req stays 'sent'/coalescable before
# it's derived-expired. 900s (15 min) is the protocol value; overridable
# only so tests/tools/e2e_v2.py's derived-expiry scenario doesn't wait 15
# real minutes. Never set this in a real deployment.
LOC_REQ_TTL_S=900

# docs/SERVER_PLAN.md §6.4, Phase 5: app/backends/sms_stub.py (the Phase 5
# stub -- TODO(orchestrator): replaced by the real Twilio adapter in
# Phase 7) points its outbound sends at this base URL, e.g. the Twilio-
# Messages-API-shaped mock at tools/mocks/twilio_mock.py (wired into
# docker-compose.yml as the `twilio-mock` service, which is what the value
# below points at). If this var is unset entirely (unlike here, where this
# file sets it for local dev against the mock), sms deliveries stay
# 'queued' rather than failing outright, so setting it later recovers them
# on the next /internal/tick. Never set this to a real Twilio URL without
# also finishing the real adapter (Phase 7) -- the stub has no signature
# verification, no link flow, no 10DLC handling.
TWILIO_BASE_URL=http://twilio-mock:8010
TWILIO_ACCOUNT_SID=ACdev0000000000000000000000000000
TWILIO_FROM_NUMBER=+15005550006

# docs/SERVER_PLAN.md §5.7: query page size, per collection, per iteration
# of app.jobs.sweep()'s retention sweep. Set here to 500, app/jobs.py's own
# default, matching §5.7's "limit 500" mechanics description -- this line
# only documents that default and is safe to leave as-is (or delete) in a
# real deployment. Only tests override it to something smaller, to force a
# sweep's internal loop to run more than once without creating hundreds of
# documents; never lower it in a real deployment.
SWEEP_BATCH=500
