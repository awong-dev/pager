# RELAY_TOKEN gates the legacy `RELAY_TOKEN`-bearer endpoints only
# (POST/GET /api/devices/{id}/messages, deleted in Phase 6, docs/SERVER_PLAN.md
# §5.1) -- everything else uses a Firebase ID token (app/auth.py).
RELAY_TOKEN=your_secure_token_here

# The relay never holds an MQTT connection (docs/SERVER_PLAN.md §2 decision
# 1). Device traffic arrives via POST /webhooks/mqtt from the broker's rule
# engine (auth: WEBHOOK_KEY below); the relay publishes /down through the
# broker's REST publish API at BROKER_API_URL.
BROKER_API_URL=http://emqx:18083/api/v5
BROKER_API_KEY=dev-broker-api-key
BROKER_API_SECRET=dev-broker-api-secret
WEBHOOK_KEY=dev-webhook-key

# Unused now that Firestore replaced SQLite (docs/SERVER_PLAN.md §2 decision
# 3) -- kept only so an old .env doesn't need editing; safe to delete.
RELAY_DB_PATH=relay.db

# Firestore is the only store; firebase-admin is emulator-aware via these
# two env vars (app/db/firestore.py). Point them at the `firebase` compose
# service (docker-compose.yml) or a locally-run
# `firebase emulators:start --only firestore,auth --project demo-pager`.
FIRESTORE_EMULATOR_HOST=firebase:8080
FIREBASE_AUTH_EMULATOR_HOST=firebase:9099
GOOGLE_CLOUD_PROJECT=demo-pager

# DEV_MODE=1 enables POST /api/dev/token (docs/SERVER_PLAN.md §5.1, §8) --
# never set this in a real deployment.
DEV_MODE=1
