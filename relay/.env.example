# RELAY_TOKEN is unused since Phase 6 deleted the legacy `RELAY_TOKEN`-bearer
# endpoints (POST/GET /api/devices/{id}/messages, docs/SERVER_PLAN.md §5.1);
# every route uses a Firebase ID token (app/auth.py). Kept only so an old
# .env doesn't need editing; safe to delete.
RELAY_TOKEN=your_secure_token_here

# The relay never holds an MQTT connection (docs/SERVER_PLAN.md §2 decision
# 1). Device traffic arrives via POST /webhooks/mqtt from the broker's rule
# engine (auth: WEBHOOK_KEY below); the relay publishes /down through the
# broker's REST publish API at BROKER_API_URL.
BROKER_API_URL=http://emqx:18083/api/v5
BROKER_API_KEY=dev-broker-api-key
BROKER_API_SECRET=dev-broker-api-secret
WEBHOOK_KEY=dev-webhook-key

# Unused now that Firestore replaced SQLite (docs/SERVER_PLAN.md §2 decision
# 3) -- kept only so an old .env doesn't need editing; safe to delete.
RELAY_DB_PATH=relay.db

# Firestore is the only store; firebase-admin is emulator-aware via these
# two env vars (app/db/firestore.py). Point them at the `firebase` compose
# service (docker-compose.yml) or a locally-run
# `firebase emulators:start --only firestore,auth --project demo-pager`.
FIRESTORE_EMULATOR_HOST=firebase:8080
FIREBASE_AUTH_EMULATOR_HOST=firebase:9099
GOOGLE_CLOUD_PROJECT=demo-pager

# DEV_MODE=1 enables POST /api/dev/token (docs/SERVER_PLAN.md §5.1, §8) --
# never set this in a real deployment.
DEV_MODE=1

# docs/PROTOCOL.md §13.4: how long a loc_req stays 'sent'/coalescable before
# it's derived-expired. 900s (15 min) is the protocol value; overridable
# only so tests/tools/e2e_v2.py's derived-expiry scenario doesn't wait 15
# real minutes. Never set this in a real deployment.
LOC_REQ_TTL_S=900

# docs/SERVER_PLAN.md §6.4: app/notify/sms.py + app/backends/sms_twilio.py
# point outbound sends at this base URL, e.g. the Twilio-Messages-API-shaped
# mock at tools/mocks/twilio_mock.py (wired into docker-compose.yml as the
# `twilio-mock` service, which is what the value below points at). If this
# var is unset entirely (unlike here, where this file sets it for local dev
# against the mock), sms deliveries stay 'queued' rather than failing
# outright, so setting it later recovers them on the next /internal/tick.
# TWILIO_AUTH_TOKEN is also the HMAC-SHA1 key for verifying
# `X-Twilio-Signature` on inbound `POST /webhooks/twilio/sms` -- blank here
# (the mock does not sign anything), which means that endpoint's signature
# check always fails closed in this compose stack (by design: there is no
# real Twilio account in dev to produce a valid signature against). See
# BUILD_LOG.md's PENDING_ACCOUNT entry for the real number-rental/10DLC
# registration this deployment still needs before a real Twilio account can
# be wired in here.
TWILIO_BASE_URL=http://twilio-mock:8010
TWILIO_ACCOUNT_SID=ACdev0000000000000000000000000000
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15005550006

# docs/SERVER_PLAN.md §6.4: the deployment's own public HTTPS origin -- must
# match, byte for byte, the URL configured in the Twilio console for
# `/webhooks/twilio/sms` and in the Google Chat API console for
# `/webhooks/gchat`'s audience/redirect setup, since Twilio signs (and
# Chat's audience check implicitly assumes) the exact URL it was told to
# call. Blank in dev -- there is no real Twilio/Chat account calling this
# compose stack, so both inbound webhooks' signature/JWT checks always fail
# closed here (by design, see the TWILIO_AUTH_TOKEN comment above).
PUBLIC_BASE_URL=

# docs/SERVER_PLAN.md §6.5: app/backends/gchat.py. GCHAT_AUDIENCE is the
# Chat app's project-number audience Google's JWT `aud` claim must match;
# blank means POST /webhooks/gchat's JWT check always fails closed (no real
# Chat app configured in dev). GCHAT_CERTS_URL overrides the cert-fetch
# endpoint only for tests (the real default is Google's own published Chat
# service-account cert URL, hardcoded in app/backends/gchat.py). See
# BUILD_LOG.md's PENDING_ACCOUNT entry for the Google Workspace caveat
# (§11 D4) this backend depends on.
GCHAT_AUDIENCE=
GCHAT_CERTS_URL=

# docs/SERVER_PLAN.md §5's tasks.py line. TASKS_MODE=inline (the default,
# unchanged) runs every retry synchronously in-process -- real deployments
# never need to set the TASKS_* vars below. TASKS_MODE=cloud_tasks selects
# app/tasks.py's CloudTasksQueue, which is not yet usable end-to-end (see
# that module's docstring's "known gap" section) -- do not set this in a
# real deployment yet.
TASKS_MODE=inline
TASKS_LOCATION=us-central1
TASKS_QUEUE=relay-retries
TASKS_SERVICE_ACCOUNT_EMAIL=

# docs/SERVER_PLAN.md §5.7: query page size, per collection, per iteration
# of app.jobs.sweep()'s retention sweep. Set here to 500, app/jobs.py's own
# default, matching §5.7's "limit 500" mechanics description -- this line
# only documents that default and is safe to leave as-is (or delete) in a
# real deployment. Only tests override it to something smaller, to force a
# sweep's internal loop to run more than once without creating hundreds of
# documents; never lower it in a real deployment.
SWEEP_BATCH=500
