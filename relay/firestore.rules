// Firestore security rules -- docs/SERVER_PLAN.md §3's sketch, made exact.
//
// The relay is the only writer (app/db/firestore.py uses the firebase-admin
// SDK, which bypasses these rules entirely -- docs/SERVER_PLAN.md §2
// decision 3). These rules exist purely to bound *client* reads (the web
// app talking to Firestore directly, docs/SERVER_PLAN.md §5.1) and to make
// that boundary independently testable (relay/tests/test_rules.py drives
// this file through the emulator's real enforcement, not relay-side logic).
rules_version = '2';

service cloud.firestore {
  match /databases/{db}/documents {
    function registered() {
      return exists(/databases/$(db)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      // `.get('admin', false)`, not a bare `request.auth.token.admin`
      // (same root cause as `devices/{d}`'s `locatableBy` note below): a non-admin caller's token simply has no
      // `admin` claim at all (`app/auth.py`'s `_set_admin_claim` only ever
      // sets it for actual admins), and Firestore's *abstract* rule
      // pre-check for `list` (collection query) requests -- run once
      // against the query's shape, before any real document -- throws
      // `PERMISSION_DENIED: Property admin is undefined on object` on a
      // bare field access instead of just treating it as falsy. Every
      // `allow read` in this file routes through `isAdmin()`, so this one
      // fix covers all of them; a bare `get` (single-document read, what
      // every single-document test exercises) is unaffected either way.
      return request.auth.token.get('admin', false) == true;
    }

    match /users/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();

      match /backends/{b} {
        allow read: if request.auth.uid == uid || isAdmin();
      }
    }

    // A `list` against either collection is authorised by an *abstract*
    // pre-check, run against the query's own declared filters before any
    // document is read -- so the query MUST carry a filter this rule can
    // prove itself from, i.e. `where('uids', 'array-contains', <self>)`.
    // Both readers do (web/app/chat/page.tsx for conversations,
    // chat/[alias]/ThreadPageClient.tsx for messages). A thread query
    // filtered only on `convKey` is denied outright, which is correct: it
    // asserts nothing about who is allowed to read the result.
    // `relay/tests/test_rules.py` pins both directions.
    match /messages/{id} {
      allow read: if registered() && request.auth.uid in resource.data.uids;
    }

    match /conversations/{k} {
      allow read: if registered() && request.auth.uid in resource.data.uids;
    }

    match /devices/{d} {
      // `.get('locatableBy', [])`, not a bare `resource.data.locatableBy`
      // every `devices/{d}` document created by
      // `app/store/devices.py`'s `create_device` always sets `locatableBy`
      // explicitly, so a `get` (single-document read) never actually hits a
      // missing field. But `list` (collection query -- e.g.
      // `tools/pager_client.py`'s `locations()`, which queries `devices`
      // filtered by `ownerUid` to resolve an alias to a device id)
      // evaluates this rule in an additional, *abstract* pre-check against
      // the query's own filter shape before touching real documents, and
      // that abstract check has no `locatableBy` value to offer -- a bare
      // `resource.data.locatableBy` access throws `PERMISSION_DENIED:
      // Property locatableBy is undefined on object` for every `list`
      // query, even ones a real client is fully allowed to run and that
      // return zero matches. The null-safe accessor sidesteps the abstract
      // check without changing what any `get` ever returned.
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.get('locatableBy', []) ||
        isAdmin()
      );

      match /locations/{l} {
        allow read: if request.auth != null &&
          request.auth.uid in
            get(/databases/$(db)/documents/devices/$(d)).data.get('locatableBy', []);
      }

      // docs/V02_DESIGN.md §6: device-direct SMS audit log. Owner and admin
      // only -- unlike `locations`, this is *not* opened up to everyone in
      // `locatableBy` (a location permission says nothing about whether
      // someone should read a kid's SMS history). The web app actually
      // reads this through `GET /api/devices/{id}/sms-log`
      // (`app/routers/devices.py`), not straight from Firestore -- this
      // rule exists so that boundary is enforced independently of the API
      // route too, the same "the rule, not just the code" discipline this
      // file's own header comment states, and per this task's own brief
      // ("client-readable only by the device's owner and admins if the
      // rules already give owners read access to their device document" --
      // they do, `devices/{d}`'s own `allow read` above).
      match /smsLog/{l} {
        allow read: if request.auth != null && (
          isAdmin() ||
          get(/databases/$(db)/documents/devices/$(d)).data.ownerUid == request.auth.uid
        );
      }
    }

    match /allow/{e} {
      allow read: if request.auth != null && (
        isAdmin() ||
        request.auth.uid in [resource.data.fromUid, resource.data.toUid]
      );
    }

    // docs/DEVICE_PLAN.md §4.1: "`contactRequests` is readable by admins and
    // by the device owner (the kid can see their own pending list in the web
    // app too); written only by the relay."
    match /contactRequests/{r} {
      allow read: if request.auth != null && (
        isAdmin() || request.auth.uid == resource.data.ownerUid
      );
    }

    match /settings/{s} {
      allow read: if registered();
    }

    // Clients never write; the admin claim is a Firebase custom claim, set
    // by the relay (app/auth.py), and every write goes through the relay API.
    match /{document=**} {
      allow write: if false;
    }
  }
}
