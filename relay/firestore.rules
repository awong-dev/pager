// Firestore security rules -- docs/SERVER_PLAN.md §3's sketch, made exact,
// and docs/FAMILIES_DESIGN.md §3's rules sketch (multi-family rules v2,
// docs/FAMILIES_TASKS.md 1.4).
//
// The relay is the only writer (app/db/firestore.py uses the firebase-admin
// SDK, which bypasses these rules entirely -- docs/SERVER_PLAN.md §2
// decision 3). These rules exist purely to bound *client* reads (the web
// app talking to Firestore directly, docs/SERVER_PLAN.md §5.1) and to make
// that boundary independently testable (relay/tests/test_rules.py drives
// this file through the emulator's real enforcement, not relay-side logic).
rules_version = '2';

service cloud.firestore {
  match /databases/{db}/documents {
    function registered() {
      return exists(/databases/$(db)/documents/users/$(request.auth.uid));
    }

    // Claims-only (FAMILIES_DESIGN.md §1 decision 2 / §3): `role` and `fam`
    // are the *only* source of truth for these rules -- the legacy `admin`
    // custom claim is never consulted anywhere below. `role() == 'admin'`
    // now means *family* admin, scoped by `fam()`, not the old global
    // admin bit; a bare `admin: true` claim with no `role`/`fam` claim
    // grants nothing (`role()`/`fam()` both default to `''`, so every
    // predicate below is false for it, same as a plain member).
    function role() { return request.auth.token.get('role', ''); }
    function fam() { return request.auth.token.get('fam', ''); }
    function isSuper() { return role() == 'super'; }
    function isFamAdmin(f) { return role() == 'admin' && fam() == f; }
    function sameFam(f) { return fam() != '' && fam() == f; }

    match /families/{f} {
      allow read: if request.auth != null && (isSuper() || sameFam(f));

      match /alerts/{a} {
        allow read: if request.auth != null && (isSuper() || isFamAdmin(f));
      }
    }

    match /users/{uid} {
      // Super, self, or a same-family member (`.get('familyId', null)`, not
      // a bare `resource.data.familyId`, for the same abstract-list-precheck
      // reason as `devices/{d}`'s `locatableBy` below -- see that comment).
      // Externals have `familyId: null`; `sameFam(null)` is always false
      // (`fam()` is never `null`), so a member can only ever resolve an
      // external through a conversation's `participants` map, never by
      // reading `users/{uid}` directly (FAMILIES_DESIGN.md §3's own note).
      allow read: if request.auth != null && (
        isSuper() || request.auth.uid == uid ||
        sameFam(resource.data.get('familyId', null))
      );

      // No family copy on `backends/{b}` docs -- self or super only, same
      // as before this task (FAMILIES_DESIGN.md 1.4: "stays self or super").
      match /backends/{b} {
        allow read: if request.auth.uid == uid || isSuper();
      }

      // Per-owner nicknames (docs/ADDRESS_BOOK_DESIGN.md decision 8); the
      // relay is the only writer, the catch-all denies client writes.
      match /book/{peer} {
        allow read: if request.auth != null && (isSuper() || request.auth.uid == uid ||
          isFamAdmin(resource.data.get('familyId', null)));
      }
    }

    // A `list` against either collection is authorised by an *abstract*
    // pre-check, run against the query's own declared filters before any
    // document is read -- so the query MUST carry a filter this rule can
    // prove itself from, i.e. `where('uids', 'array-contains', <self>)` or,
    // for a family admin's monitor view, `where('familyIds',
    // 'array-contains', <fam>)`. Both readers do (web/app/chat/page.tsx for
    // conversations, chat/[alias]/ThreadPageClient.tsx and the family
    // monitor thread for messages). A thread query filtered only on
    // `convKey` is denied outright, which is correct: it asserts nothing
    // about who is allowed to read the result. `relay/tests/test_rules.py`
    // pins both directions.
    //
    // docs/FAMILIES_TASKS.md 2.2 / docs/FAMILIES_DESIGN.md §3: super, a
    // party (`uids`), or a family admin whose family is in the document's
    // `familyIds` (populated by 2.1; `.get(..., [])` so a document written
    // before 2.1 lands, or one with no `familyIds` at all, simply excludes
    // the family-admin clause instead of throwing). Symmetric across both
    // families of a cross-family DM/group by construction, since
    // `familyIds` is the union of every participant's family.
    match /messages/{id} {
      allow read: if registered() && (
        isSuper() ||
        request.auth.uid in resource.data.uids ||
        (role() == 'admin' && fam() in resource.data.get('familyIds', []))
      );
    }

    match /conversations/{k} {
      allow read: if registered() && (
        isSuper() ||
        request.auth.uid in resource.data.uids ||
        (role() == 'admin' && fam() in resource.data.get('familyIds', []))
      );
    }

    match /devices/{d} {
      // `.get('locatableBy', [])`/`.get('familyId', null)`, not a bare
      // `resource.data.locatableBy`/`.familyId`: every `devices/{d}`
      // document created by `app/store/devices.py`'s `create_device`
      // always sets `locatableBy` explicitly, so a `get` (single-document
      // read) never actually hits a missing field. But `list` (collection
      // query -- e.g. `tools/pager_client.py`'s `locations()`, which
      // queries `devices` filtered by `ownerUid` to resolve an alias to a
      // device id) evaluates this rule in an additional, *abstract*
      // pre-check against the query's own filter shape before touching
      // real documents, and that abstract check has no `locatableBy`/
      // `familyId` value to offer -- a bare field access throws
      // `PERMISSION_DENIED: Property ... is undefined on object` for
      // every `list` query, even ones a real client is fully allowed to
      // run and that return zero matches. The null-safe accessor
      // sidesteps the abstract check without changing what any `get`
      // ever returned.
      //
      // Super, or same-family and (owner, a `locate` edge holder, or a
      // family admin of this device's family) -- FAMILIES_DESIGN.md §1
      // decision 5: family admins read and request location for every
      // device in their family.
      allow read: if request.auth != null && (
        isSuper() || (
          sameFam(resource.data.get('familyId', null)) && (
            resource.data.ownerUid == request.auth.uid ||
            request.auth.uid in resource.data.get('locatableBy', []) ||
            role() == 'admin'
          )
        )
      );

      // The parent (`devices/{d}`) predicate via `get()`, exactly --
      // FAMILIES_DESIGN.md §1 decision 5 extends location reads to a
      // family admin of the device's family, superseding the 27 Sep
      // owner-only decision's admin exclusion for this subcollection.
      match /locations/{l} {
        allow read: if request.auth != null && (
          isSuper() || (
            sameFam(get(/databases/$(db)/documents/devices/$(d)).data.get('familyId', null)) && (
              get(/databases/$(db)/documents/devices/$(d)).data.ownerUid == request.auth.uid ||
              request.auth.uid in
                get(/databases/$(db)/documents/devices/$(d)).data.get('locatableBy', []) ||
              role() == 'admin'
            )
          )
        );
      }

      // docs/V02_DESIGN.md §6: device-direct SMS audit log. Super, the
      // device's own owner, or a family admin of this device's family --
      // deliberately narrower than `locations` for `role() == 'admin'`
      // outside the owner's own family (a location permission says
      // nothing about whether someone should read a kid's SMS history,
      // but a family admin of the *same* family may, same as before).
      match /smsLog/{l} {
        allow read: if request.auth != null && (
          isSuper() ||
          get(/databases/$(db)/documents/devices/$(d)).data.ownerUid == request.auth.uid ||
          isFamAdmin(get(/databases/$(db)/documents/devices/$(d)).data.get('familyId', null))
        );
      }
    }

    match /allow/{e} {
      allow read: if request.auth != null && (
        isSuper() ||
        request.auth.uid in [resource.data.fromUid, resource.data.toUid] ||
        (role() == 'admin' && fam() in resource.data.get('familyIds', []))
      );
    }

    // docs/DEVICE_PLAN.md §4.1: "`contactRequests` is readable by admins and
    // by the device owner (the kid can see their own pending list in the web
    // app too); written only by the relay." Now super, the owner, or a
    // family admin of the request's family.
    match /contactRequests/{r} {
      allow read: if request.auth != null && (
        isSuper() ||
        request.auth.uid == resource.data.ownerUid ||
        isFamAdmin(resource.data.get('familyId', null))
      );
    }

    match /settings/{s} {
      allow read: if registered();
    }

    // Clients never write; role/family are Firebase custom claims, set by
    // the relay (app/auth.py), and every write goes through the relay API.
    match /{document=**} {
      allow write: if false;
    }
  }
}
