# Copy to .env.local for local dev against the emulator stack
# (docker compose -f relay/docker-compose.yml up). None of these are secrets
# -- Firebase web config is public by design, and the emulator has no real
# credentials behind it.

# Gates connectAuthEmulator/connectFirestoreEmulator (lib/firebase.ts).
# Leave "1" for local dev against relay/docker-compose.yml; unset (or "0")
# only once pointed at a real Firebase project (never done in this repo).
NEXT_PUBLIC_USE_EMULATORS=1
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=localhost
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
NEXT_PUBLIC_AUTH_EMULATOR_URL=http://localhost:9099

# Matches relay/.firebaserc / relay/docker-compose.yml's GOOGLE_CLOUD_PROJECT.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-pager
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-pager.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-pager.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=0
NEXT_PUBLIC_FIREBASE_APP_ID=1:0:web:0

# Only meaningful against a real Firebase project (Cloud Messaging -> Web
# Push certificates). Unset in the emulator stack -- lib/notifications.ts's
# registerForPush() returns null without it, which /settings/notifications
# surfaces as "notifications were not enabled".
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
