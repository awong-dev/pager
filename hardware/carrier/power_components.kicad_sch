	)
	(text "Battery + Fuel Gauge\n\nBattery: J2 (pin 1 = +)\n\nFuel gauge U10 MAX17048.\nBefore the switch to track while off, ~3 uA\nI2C1 (ACC_*), addr 0x36. QSTRT and CTG low."
		(exclude_from_sim no)
		(at 112.522 96.52 0)
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.1875)
			)
			(justify left top)
		)
		(uuid "662bcb2f-8cf5-4745-8708-8b9dfbfc9299")
	)
	(text "Q2 2.2M gate pull-up. (1.9 uA when off)\n10k + 22nF soft-start limits inrush to Walter Bulk Caps."
		(exclude_from_sim no)
		(at 102.108 101.6 0)
		(effects
			(font
				(size 1 1)
			)
			(justify right)
		)
		(uuid "81faaed7-66c1-4b3c-b041-5248ce6fc632")
	)
	(text "D4: flow-through TVS for ESD protection.\nConnector pads into pins 1/3,\nout of pins 6/4 toward U5."
		(exclude_from_sim no)
		(at 84.074 72.136 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a6d8a1cb-e080-461e-b62f-8bb0396132c5")
	)
	(text "3.3 V always-on rail: TPS62840DLCR buck from SYS_SW, 2.2uH, 10uF in/out.\nVSET 267k = 3.3 V.\nMODE low = power-save (DNP 0R to 3V3 can force PWM)"
		(exclude_from_sim no)
		(at 190.754 17.78 0)
		(effects
			(font
				(size 1.5 1.5)
