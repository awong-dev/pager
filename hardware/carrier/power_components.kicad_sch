	(text "USB-C: vertical GCT USB4235-03-C (J1), 6.5 mm tall. CC1/CC2 5.1k to GND (UFP).\nD+/D- A and B pads joined at the connector, through the TVS D4 to the bridge U5."
		(exclude_from_sim no)
		(at 18.73 18 0)
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.1875)
			)
			(justify left top)
		)
		(uuid "24e3696f-dac7-42a2-804a-619e478440e1")
	)
	(text "ISET 604R = 497 mA fast charge. \nILIM/VSET 18k = 500 mA input limit, 4.20 V"
		(exclude_from_sim no)
		(at 13.462 99.568 0)
		(effects
