	(text "Bus-powered: VREGIN from VBUS\nVBUS sense pin via 22.1k/47.5k\nVDD = internal 3.3 V regulator output\nVIO tied to VDD, 4.7uF + 100nF per power pin.\nProgram the USB product string with\nSimplicity Studio XpressConfigurator after assembly."
		(exclude_from_sim no)
		(at 19.812 141.478 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "115f4828-fd37-482c-a0e0-ed095f8586c5")
	)
	(text "Q2/Q3 are the two halves of one UMH3N (Q2A/Q2B)\nThe Walter already pulls EN up (10k)\nIO0 has only the ESP32 internal pull-up."
		(exclude_from_sim no)
		(at 135.636 151.638 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1b0b19fb-0f3b-4077-9d4f-9051ac0b398c")
	)
	(text "E-ink display. J3 10-pin JST SH cable connecting carrier to panel board.\n\nThe SSD1680 ZIF, boost/charge-pump cluster, and the front-light 6-pin ZIFs\nlive on a separate panel board. This connects the SPI channel, provides\nmeasurement points, and also provides a clamped power for the Front Light.\nFront Light expects 3 or 4 LEDs from Vf 3.3V to vF 2.8V."
		(exclude_from_sim no)
		(at 168.402 18.288 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify left top)
		)
		(uuid "228311b7-af07-44e9-aa1f-0df543842222")
	)
	(text "Auto-reset (Espressif):\nQ2 DTR->EN, Q3 RTS->IO0.\nJP1 (closed) in Q3's collector lets\nauto-boot be disabled reset still works.\n"
		(exclude_from_sim no)
		(at 136.144 136.144 0)
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.1875)
			)
			(justify left top)
		)
		(uuid "368fc718-ebee-4106-b1e4-2d9f563ca841")
	)
	(text "Haptic (DNP): DRV2605L on I2C1 (0x5A)\nOUT+/- to J7"
		(exclude_from_sim no)
		(at 297.18 134.62 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "4affa7f2-78ed-41c1-865a-bb3cf7577564")
	)
	(text "External LED Header"
		(exclude_from_sim no)
		(at 374.142 133.604 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "56fd3260-eb43-4bea-a532-8a670c385250")
	)
	(text "Accelerometer\nU7 LIS2DW12 on I2C1 (ACC_*), SA0 low = 0x18\nAlways on from 3V3\nCS high = I2C mode, INT1 -> IO16 (RTC wake)"
		(exclude_from_sim no)
		(at 325.628 17.526 0)
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.1875)
			)
			(justify left top)
		)
		(uuid "5a39d1e3-743d-4b38-ac6f-feb3dcbef117")
	)
	(text "Buffer to disable the serial when no VBUS\n\nU6 SN74LVC2G126: both OE from VBUS_DET.\nA: ESP_TX0 -> BRG_RXD. B: BRG_TXD -> ESP_RX0.\n10k keeps ESP_RX0 high with no cable.\nU6 VCC is BRG_3V3 (bus-powered).\nwith no cable the buffer is unpowered (Ioff outputs) so\nno LVC quiescent/float current on the battery."
		(exclude_from_sim no)
		(at 205.994 135.636 0)
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.1875)
			)
			(justify left top)
		)
		(uuid "5dcbe61e-ef06-4bea-b1bd-660f2afb964e")
	)
	(text "Place U7 away from J7 and the panel cable; X axis along the\ntin's long edge; mark orientation on silk."
		(exclude_from_sim no)
		(at 332.994 106.934 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "721638ab-18c7-4fde-b8ae-a28bdd09b65f")
	)
	(text "Bulk Cap at Walter VIN (pin 28)\nPut 2 x 100uF within 5 mm\nof the pin to smooth"
		(exclude_from_sim no)
		(at 126.492 43.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7752863d-ed98-4eaf-91dd-a0916e0f8cdc")
	)
