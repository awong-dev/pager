      (pins C4-2 D2-1 C3-2 R3-2 R4-2 C11-2 C10-2 C9-2 C8-2 C7-2 C6-2 C2-2 C1-2 J2-2
        J1-8 J1-17)
    )
    (net "unconnected-(J1-Pin_1-Pad1)"
      (pins J1-1)
    )
    (net "unconnected-(J1-Pin_4-Pad4)"
      (pins J1-4)
    )
    (net "unconnected-(J1-Pin_6-Pad6)"
      (pins J1-6)
    )
    (net "unconnected-(J1-Pin_7-Pad7)"
      (pins J1-7)
    )
    (net "unconnected-(J1-Pin_19-Pad19)"
      (pins J1-19)
    )
    (class kicad_default 3V3_EPD EPD_BUSY EPD_CS EPD_DC EPD_GDR EPD_MOSI EPD_PUMP
      EPD_RESE EPD_RST EPD_SCK EPD_SW EPD_VCOM EPD_VDD EPD_VGH EPD_VGL EPD_VSH1
      EPD_VSH2 EPD_VSL GND "unconnected-(J1-Pin_1-Pad1)" "unconnected-(J1-Pin_19-Pad19)"
      "unconnected-(J1-Pin_4-Pad4)" "unconnected-(J1-Pin_6-Pad6)" "unconnected-(J1-Pin_7-Pad7)"
      (circuit
        (use_via "Via[0-1]_500:250_um")
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
  )
  (wiring
  )
)
